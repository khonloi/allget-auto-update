{
  "systemChecks": {
    "skipOnMeteredConnection": true,
    "minBatteryLevel": 50,
    "maxCpuLoad": 80
  },
  "delayUpdates": {
    "enabled": true,
    "days": 1
  },
  "ignoredPatterns": [
    "^Microsoft\\.Edge",
    "^Microsoft\\.OneDrive",
    "^Microsoft\\.Teams",
    "^Microsoft\\.WindowsStore",
    "^Microsoft\\.Defender"
  ]
}
